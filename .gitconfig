[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	lol = log --graph --oneline --decorate --color --all
[credential]
	helper = osxkeychain
[include]
	path = ~/.gitconfig.local
[user]
	name = Timothy Kostolansky
	email = 39891386+tim0120@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore_global
[gpg]
	format = ssh
[commit]
	gpgsign = true
